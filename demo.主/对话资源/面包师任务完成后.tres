[sub_resource type="Resource" id="Resource_ggvom"]
script = ExtResource("2_wkgvy")
Text = "阿明无奈地摇头，然后把猫放到柜台后面的一个软垫子上。他转过身，从墙角那一堆面粉里挑出一袋最鼓的，用牛皮纸又裹了一层，递到你手里。"
SpeakerName = ""
StyleProperties = null
