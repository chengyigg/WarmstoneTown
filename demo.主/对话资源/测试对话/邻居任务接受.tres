[sub_resource type="Resource" id="Resource_5ieo1"]
script = ExtResource("2_xafai")
Text = "真的？哎哟！太好了！你这孩子真是……我都不知道说什么好了！"
SpeakerName = "张德贵"
Avatar = ExtResource("5_8l7mh")
StyleProperties = null
