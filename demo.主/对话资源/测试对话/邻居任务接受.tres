[sub_resource type="Resource" id="Resource_mhhuo"]
script = ExtResource("2_xafai")
Text = "那个……/其实我找你，是有件事想麻烦你。说出来都有点不好意思……/我昨天下午在院子里收拾杂物，把大门钥匙给弄丢了。"
SpeakerName = "张德贵"
Avatar = ExtResource("9_qp2kn")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_hcgy0"]
script = ExtResource("2_xafai")
Text = "我亲眼看见的——一只黑毛野狗，叼着我的钥匙就跑了。/我追出去十几步，那狗一溜烟钻进镇子东边的便利店周围去了。/我这老腿啊，跑两步就喘得不行，实在追不上。"
SpeakerName = "张德贵"
Avatar = ExtResource("10_pap1a")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_3nvs6"]
script = ExtResource("2_xafai")
Text = "我知道你才刚搬来，行李都没收拾利索呢……/可我这儿实在没别的办法了。/那串钥匙上挂着我老伴给我编的一根小皮绳，/她走了好些年了……要是真丢了，我心疼。"
SpeakerName = "张德贵"
Avatar = ExtResource("9_qp2kn")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_y37s2"]
script = ExtResource("2_xafai")
Text = "所以……能不能麻烦你帮我跑一趟？/那只狗我认得，就爱在便利店边上的土路上晃悠。/你沿着镇子东边那条路走，一会儿就能看见。/要是……要是你方便的话。"
SpeakerName = "张德贵"
Avatar = ExtResource("5_8l7mh")
StyleProperties = null
"添加的跟随者预制体列表" = null
