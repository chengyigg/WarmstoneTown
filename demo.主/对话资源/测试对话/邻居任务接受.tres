[sub_resource type="Resource" id="Resource_xlqq6"]
script = ExtResource("2_xafai")
Text = "（他刚想继续说，忽然一拍脑门，转身往里屋走）"
SpeakerName = ""
StyleProperties = null
"添加的跟随者预制体列表" = null
