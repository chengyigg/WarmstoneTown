[sub_resource type="Resource" id="Resource_xafai"]
script = ExtResource("2_xafai")
Text = "你等一下，先别急着走——我这儿有样东西给你。"
SpeakerName = "张德贵"
Avatar = ExtResource("6_a2qbm")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_ymjyu"]
script = ExtResource("2_xafai")
Text = "这是我儿子小张以前在镇上当冒险者时用的入门卡组。那小子年轻时候也爱到处跑，非要学什么卡牌对战。后来他去了城里讨生活，说用不上了，就留在我这儿。"
SpeakerName = "张德贵"
Avatar = ExtResource("9_qp2kn")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_715j0"]
script = ExtResource("2_xafai")
Text = "出门在外手里有张牌心里不慌。那只野狗虽然看着瘦，可它龇起牙来也够吓人的。你拿着这个，万一真打起来，也有个防身的底气。"
SpeakerName = "张德贵"
Avatar = ExtResource("9_pap1a")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_3tpse"]
script = ExtResource("2_xafai")
Text = "收着吧！里面有基础攻击牌、几张防御牌，还有一张小小的回复牌——我听我儿子说，新手用这个正合适。就当是我这老邻居给你的一份见面礼。"
SpeakerName = "张德贵"
Avatar = ExtResource("6_a2qbm")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_huy3f"]
script = ExtResource("2_xafai")
Text = "好了，东西给你了，可你还是要小心点啊。那狗凶得很，龇牙咧嘴的。你找着它，它要是不给，你就吓唬吓唬它，别硬抢——打不过就跑，回来再想办法。"
SpeakerName = "张德贵"
Avatar = ExtResource("5_8l7mh")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_544r2"]
script = ExtResource("2_xafai")
Text = "就顺着这条路走，走个两百来步就到便利店了。我就在家等你，给你泡好茶！"
SpeakerName = "张德贵"
Avatar = ExtResource("6_a2qbm")
