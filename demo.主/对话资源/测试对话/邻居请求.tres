[sub_resource type="Resource" id="Resource_q2fes"]
script = ExtResource("2_4bsb0")
Text = "正式介绍一下——我在这暖石镇住了快四十年了，/镇上的老老小小都认识我。我呀，没什么大本事，就是会烤点蛋糕、修修东西。/你刚来暖石镇，有什么不熟悉的尽管问我。"
SpeakerName = "张德贵"
Avatar = ExtResource("5_b87cf")
StyleProperties = null
