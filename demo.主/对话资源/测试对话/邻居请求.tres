[sub_resource type="Resource" id="Resource_vj35h"]
script = ExtResource("2_4bsb0")
Text = "暖石镇啊……不大，就几百口人。但地方好，有山有水。镇子东边那片老林子，里头有野兔和山鸡，西边的河水清得能看见底。镇上的人嘛，都实在。你在城里头待久了，到这儿来能睡个安稳觉。"
SpeakerName = "张德贵"
Avatar = ExtResource("3_q2fes")
StyleProperties = null
"添加的跟随者预制体列表" = null
