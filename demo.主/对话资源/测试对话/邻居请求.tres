[sub_resource type="Resource" id="Resource_d1pbg"]
script = ExtResource("2_4bsb0")
Text = "是啊，老伴走了三年了。儿子在城里上班，一年回来两趟。平时就我自个儿，做做饭、种种花、烤烤蛋糕——倒也自在。"
