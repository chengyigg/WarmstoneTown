[sub_resource type="Resource" id="Resource_n0qcn"]
script = ExtResource("2_4bsb0")
Text = "哎呀，你来啦！你好你好！/我就是老张，张德贵。/昨天你搬来的时候我正好在院子里劈柴，就远远打了个招呼，也没来得及好好认识一下。来来来，坐。"
SpeakerName = "？？"
