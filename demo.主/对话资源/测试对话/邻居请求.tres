[sub_resource type="Resource" id="Resource_pagem"]
script = ExtResource("2_4bsb0")
Text = "东边那片老林子——就是你待会儿要去的地方——平时问题不大，但傍晚以后最好别进，里头有野猪。南边大路通城里，走半天能到，但路上有段坡陡，雨天滑。还有就是……"
SpeakerName = "张德贵"
Avatar = ExtResource("5_0hhhj")
StyleProperties = null
"添加的跟随者预制体列表" = null
