[sub_resource type="Resource" id="Resource_elumx"]
script = ExtResource("2_jxvl0")
Text = "他帮我找回了钥匙——就是我老伴给我编绳子的那串，差点就丢了。他帮阿明找回了大橘——那只馋猫又去偷陈婶的鱼干了。他帮王奶奶取了苹果——王奶奶腿脚不方便。我们暖石镇啊，好久没这么热闹了！"
SpeakerName = "张德贵"
