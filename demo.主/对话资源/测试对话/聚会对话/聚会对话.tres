[sub_resource type="Resource" id="Resource_jxvl0"]
script = ExtResource("2_jxvl0")
Text = "我说几句啊！今天这个蛋糕，是我给咱们新邻居烤的欢迎蛋糕。但你们知道吗——这蛋糕能烤出来，全靠他！"
SpeakerName = "张德贵"
Avatar = ExtResource("4_cj64i")
