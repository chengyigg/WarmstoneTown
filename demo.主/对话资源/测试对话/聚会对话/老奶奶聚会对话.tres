[sub_resource type="Resource" id="Resource_isncu"]
script = ExtResource("2_pqgdb")
Text = "好孩子……你让我想起我孙子了。他小时候也像你一样，爱帮人，见谁有难处都要搭把手。可惜啊，他去城里打工了，一年也回不来两趟。"
SpeakerName = "王秀兰"
