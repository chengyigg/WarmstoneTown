[sub_resource type="Resource" id="Resource_rryac"]
script = ExtResource("2_uwniv")
Text = "那个是咱们镇的存档点。老周修的，说是从城里学来的技术。你以后每天睡前记得来这儿存个档，养成习惯，不吃亏。"
SpeakerName = "张德贵"
Avatar = ExtResource("4_8jwg3")
