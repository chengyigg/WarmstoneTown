[sub_resource type="Resource" id="Resource_4yrdh"]
script = ExtResource("2_d7ukb")
Text = "这个，送给你。不是什么贵重东西，是我闲时用王奶奶家那棵老槐树的落枝刻的。上面刻了咱们镇的名字——暖石。希望你能留个纪念，记住今天。"
