[sub_resource type="Resource" id="Resource_x1ad3"]
script = ExtResource("2_m3asa")
Text = "就是这个……/这个是我老伴编的。她手巧，一根破皮绳能编出花来。这钥匙跟了我十几年了，要是丢了，我真是……"
SpeakerName = "张德贵"
