[sub_resource type="Resource" id="Resource_abgqs"]
script = ExtResource("2_m3asa")
Text = "面粉呢，要去广场东边的面包店找阿明拿。那小伙子烤面包是一把好手，面粉管够。苹果呢，得找王奶奶借——她就住在便利店北边，院子里全种的蔬菜，特别好认。"
SpeakerName = "张德贵"
Avatar = ExtResource("8_3j81i")
