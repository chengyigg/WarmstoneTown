[sub_resource type="Resource" id="Resource_37423"]
script = ExtResource("2_m3asa")
Text = "你帮了我这么大忙，我寻思着给你烤个欢迎蛋糕。不是我吹牛，我老张烤蛋糕的手艺，在暖石镇那可是一绝！当年我老伴就是吃了我的蛋糕才……"
SpeakerName = "张德贵"
Avatar = ExtResource("4_vvp01")
