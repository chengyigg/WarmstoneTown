[sub_resource type="Resource" id="Resource_emck7"]
script = ExtResource("2_nkn5r")
Text = "你是来拿面粉的吧？老张跟我说了，要给你烤欢迎蛋糕——好事啊！老张的蛋糕那真是……"
SpeakerName = "阿明"
Avatar = ExtResource("6_b5af1")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_b5af1"]
script = ExtResource("2_nkn5r")
Text = "哎哟！你看我这记性！面粉我有，多的是——那边墙角堆的都是！"
SpeakerName = "阿明"
Avatar = ExtResource("7_ouf82")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_ouf82"]
script = ExtResource("2_nkn5r")
Text = "可是我现在真顾不上给你装面粉……我家的猫，大橘，又跑啦！"
SpeakerName = "阿明"
Avatar = ExtResource("8_vuolu")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_4vr6v"]
script = ExtResource("2_nkn5r")
Text = "大橘是只橘猫，胖得都快走不动道了。它最馋杂货店陈婶晒的咸鱼干，一有机会就溜过去偷吃。我今天一早开门，它嗖一下就窜出去了，到现在也没回来。我店里还烤着三炉面包呢，实在走不开。"
SpeakerName = "阿明"
Avatar = ExtResource("9_4vr6v")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
"交互类型" = 0
"高亮控件路径" = ""
"预定义动画名称" = ""
"高亮提示文本" = ""
metadata/_custom_type_script = "uid://cbofohiqvgyn1"

[sub_resource type="Resource" id="Resource_dja50"]
script = ExtResource("2_nkn5r")
Text = "……你能不能帮我把它找回来？大橘肯定又去杂货店了，你到那儿准能找到它。你要能帮我把它带回来，面粉我二话不说，给你装最好的！"
SpeakerName = "阿明"
Avatar = ExtResource("8_vuolu")
StyleProperties = null
