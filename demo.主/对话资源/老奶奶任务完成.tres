[sub_resource type="Resource" id="Resource_8a1vx"]
script = ExtResource("2_ytyvy")
Text = "好孩子，以后没事常来奶奶这儿坐坐。院子里的花开得好，你来看花，奶奶给你泡蜂蜜水喝。"
SpeakerName = "王秀兰"
