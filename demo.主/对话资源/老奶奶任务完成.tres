[sub_resource type="Resource" id="Resource_ytyvy"]
script = ExtResource("2_ytyvy")
Text = "这个苹果啊……让我想起我老伴了。他生前最爱吃我做的苹果派。每年秋天苹果熟了，他就搬个小马扎坐在院子这棵槐树底下，看我削皮、切块。他一边看一边跟我说话，说什么都行——东家长西家短的，能说一下午。"
SpeakerName = "王秀兰"
Avatar = ExtResource("4_0kdwr")
StyleProperties = null
"添加的跟随者预制体列表" = null
"移除所有跟随者" = false
