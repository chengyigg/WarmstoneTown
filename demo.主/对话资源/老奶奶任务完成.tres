[sub_resource type="Resource" id="Resource_g7sgm"]
script = ExtResource("2_ytyvy")
Text = "哎呀你看我，老了就容易想从前的事。这些你拿去吧，老张手艺好，烤出来的蛋糕保管又香又甜。你替我告诉他——下次烤蛋糕，得给我留一块大的。"
SpeakerName = "王秀兰"
Avatar = ExtResource("5_uywbu")
StyleProperties = null
