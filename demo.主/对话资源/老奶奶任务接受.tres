[sub_resource type="Resource" id="Resource_l6g56"]
script = ExtResource("2_o2gsc")
Text = "老张跟你说借苹果的事了吧？他说要给你烤欢迎蛋糕，我听了可高兴了——这镇子好久没这么热闹了。"
